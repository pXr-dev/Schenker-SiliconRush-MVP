# This .gitignore file should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get large and could be user specific
/[Mm]emoryCaptures/

# Visual Studio cache/solution files
/[Ee]xtra/
[Oo]ffice/
.vs/
.gradle/
.export
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated VS Code files
.vscode/

# Asset meta data should only be ignored if you want to rebuild all assets on every machine
# But usually, it is crucial for Unity projects! Keep them tracked.